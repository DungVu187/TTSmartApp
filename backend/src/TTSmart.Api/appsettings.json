{
  "AuthDatabase": {
    "PasswordWriteMode": "Md5Utf8"
  },
  "SystemRoles": {
    "AdminRoleIds": [],
    "AdminRoleCodes": [ "ADMIN" ],
    "CompanyRoleIds": [],
    "CompanyRoleCodes": [ "CONGTY", "CONGTY2.0" ]
  },
  "UserAccountStatus": {
    "StatusChangesEnabled": false
  },
  "CompanyAccess": {
    "EnforceExpiration": false
  },
  "CompanyDatabase": {
    "IsLockedColumnAvailable": false
  },
  "CompanyManagement": {
    "LockChangesEnabled": false,
    "ExpirationChangesEnabled": false
  },
  "MaterialReporting": {
    "CommandTimeoutSeconds": 120
  },
  "WeighStationManagement": {
    "MaterialValueTimeoutMilliseconds": 3000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
